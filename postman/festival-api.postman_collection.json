{
  "info": {
    "name": "Festival API",
    "description": "Endpoints van de festival-api. Zet {{baseUrl}} op het adres van de API, lokaal http://localhost:7071/api.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7071/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "GET artiesten",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/artiesten",
          "host": ["{{baseUrl}}"],
          "path": ["artiesten"]
        }
      }
    },
    {
      "name": "GET podia",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/podia",
          "host": ["{{baseUrl}}"],
          "path": ["podia"]
        }
      }
    },
    {
      "name": "GET optredens",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/optredens",
          "host": ["{{baseUrl}}"],
          "path": ["optredens"]
        }
      }
    },
    {
      "name": "GET locaties",
      "request": {
        "method": "GET",
        "header": [],
