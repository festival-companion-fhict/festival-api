        }
      }
    },
    {
      "name": "GET meldingen",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-functions-key", "value": "{{functionKey}}" }],
        "url": {
          "raw": "{{baseUrl}}/meldingen",
          "host": ["{{baseUrl}}"],
          "path": ["meldingen"]
        }
      }
    },
    {
