        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_BEHANDELING\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/meldingen/1",
          "host": ["{{baseUrl}}"],
          "path": ["meldingen", "1"]
