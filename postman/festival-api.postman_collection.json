          "raw": "{{baseUrl}}/locaties",
          "host": ["{{baseUrl}}"],
          "path": ["locaties"]
        }
      }
    },
    {
      "name": "POST ping (één)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lat\": 52.440372,\n  \"lon\": 5.758726\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/pings",
          "host": ["{{baseUrl}}"],
          "path": ["pings"]
        }
      }
    },
    {
      "name": "POST pings (lijst)",
